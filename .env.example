# The model the two room agents use to read questions and choose their tools. Any OpenAI-compatible
# chat-completions endpoint that supports tool calls works. Copy this file to .env (git-ignored) and fill it in.
#
# OpenAI:      WHOSEAGENT_LLM_BASE_URL=https://api.openai.com/v1   WHOSEAGENT_LLM_MODEL=gpt-4.1-mini
# OpenRouter:  WHOSEAGENT_LLM_BASE_URL=https://openrouter.ai/api/v1   WHOSEAGENT_LLM_MODEL=qwen/qwen-2.5-72b-instruct
# Ollama:      WHOSEAGENT_LLM_BASE_URL=http://127.0.0.1:11434/v1   WHOSEAGENT_LLM_MODEL=qwen2.5:14b   (any key)
# Modal:       python scripts/modal_llm_setup.py writes these three lines for you (Qwen2.5-72B on one H100)
#
# Without a model the agents still draft reports from the watcher's hand-off and take approvals; they only
# can't answer free-form questions.
WHOSEAGENT_LLM_BASE_URL=
WHOSEAGENT_LLM_MODEL=
WHOSEAGENT_LLM_API_KEY=
