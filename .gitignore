# compose file, which is Switch's and is downloaded rather than copied here,
# and the ids of the room it made)
.env
switch/stack/
# agent credentials written by Switch Console
.switch/
# downloaded tools such as cloudflared.exe
tools/
# the demo video: browser sign-in, recordings and generated speech
demo/.profile/
demo/.profile-rehearsal/
demo/out/
demo/voice/
