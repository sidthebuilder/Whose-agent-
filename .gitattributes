# Keep the raw list files and the registry answers byte for byte, so their SHA-256 hashes match the manifest
# on every machine.
data/snapshot-2026-10-31/** -text
data/live/raw/** -text
tests/fixtures/** -text
# the captured log is quoted in reports exactly as the server wrote it
examples/*.log -text
# Windows batch files need CRLF line endings
*.bat text eol=crlf
